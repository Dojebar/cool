    componentLayout.Parent = container

    local collapsed = false
    toggleButton.MouseButton1Click:Connect(function()
        collapsed = not collapsed
        toggleButton.Text = collapsed and "+" or "−"
        container.Visible = not collapsed
    end)

    local sectionObject = setmetatable({
        Tab = self,
        Window = self.Window,
        Frame = frame,
        Container = container
    }, Section)

    table.insert(self.Sections, sectionObject)
    return sectionObject
end

local function makeComponentBase(window, text)
    local holder = Instance.new("Frame")
    holder.Name = text:gsub("%s", "") .. "_Component"
    holder.Size = UDim2.new(1, 0, 0, 54)
    holder.BackgroundColor3 = window.Theme.Interactive
    holder.AutomaticSize = Enum.AutomaticSize.Y
    makeCornered(holder, 6)
    createStroke(holder, window.Theme.SectionBorder, 1).Transparency = 0.4

    local title = Instance.new("TextLabel")
    title.Name = "Title"
    title.Size = UDim2.new(1, -12, 0, 20)
    title.Position = UDim2.new(0, 8, 0, 6)
    title.BackgroundTransparency = 1
    title.Font = Enum.Font.Gotham
    title.TextSize = 14
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.TextColor3 = window.Theme.Text
    title.Text = text
    title.Parent = holder

    local description = Instance.new("TextLabel")
    description.Name = "Description"
    description.Size = UDim2.new(1, -12, 0, 18)
    description.Position = UDim2.new(0, 8, 0, 26)
    description.BackgroundTransparency = 1
    description.Font = Enum.Font.Gotham
    description.TextSize = 12
    description.TextXAlignment = Enum.TextXAlignment.Left
    description.TextColor3 = window.Theme.Subtext
    description.TextTransparency = 0.2
    description.Text = ""
    description.Parent = holder

    return holder, title, description
end

--[[ COMPONENTS ]]--

function Section:AddButton(settings)
    settings = settings or {}
    assert(settings.Text, "AddButton requires Text")
    local holder, title, description = makeComponentBase(self.Window, settings.Text)
    if settings.Description then
        description.Text = settings.Description
    else
        description.Visible = false
        holder.Size = UDim2.new(1, 0, 0, 40)
    end
    holder.Parent = self.Container

    local button = Instance.new("TextButton")
    button.Name = "Action"
    button.Size = UDim2.new(0, 120, 0, 28)
    button.Position = UDim2.new(1, -128, 0, 8)
    button.AnchorPoint = Vector2.new(0, 0)
    button.AutoButtonColor = false
    button.Font = Enum.Font.GothamBold
    button.TextSize = 13
    button.Text = settings.ButtonText or "Execute"
    applyTheme(button, {
        BackgroundColor3 = self.Window.Theme.Accent,
        TextColor3 = self.Window.Theme.AccentText
    })
    makeCornered(button, 6)
    button.Parent = holder

    button.MouseEnter:Connect(function()
        tween(button, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = self.Window.Theme.Accent:Lerp(Color3.new(1, 1, 1), 0.1)
        })
    end)
    button.MouseLeave:Connect(function()
        tween(button, TweenInfo.new(0.15), {
            BackgroundColor3 = self.Window.Theme.Accent
        })
    end)
    button.MouseButton1Click:Connect(function()
        if settings.Callback then
            settings.Callback()
        end
    end)

    return {
        SetText = function(_, newText)
            button.Text = newText
        end,
        SetEnabled = function(_, enabled)
            button.Active = enabled
            button.AutoButtonColor = enabled
            button.TextTransparency = enabled and 0 or 0.5
            button.BackgroundTransparency = enabled and 0 or 0.3
        end
    }
end

function Section:AddToggle(settings)
    settings = settings or {}
    assert(settings.Text, "AddToggle requires Text")
    local holder, title, description = makeComponentBase(self.Window, settings.Text)
    if settings.Description then
        description.Text = settings.Description
    else
        description.Visible = false
        holder.Size = UDim2.new(1, 0, 0, 40)
    end
    holder.Parent = self.Container

    local toggleButton = Instance.new("TextButton")
    toggleButton.Name = "ToggleButton"
    toggleButton.Size = UDim2.new(0, 44, 0, 22)
    toggleButton.Position = UDim2.new(1, -60, 0, 10)
    toggleButton.AnchorPoint = Vector2.new(0, 0)
    toggleButton.BackgroundColor3 = self.Window.Theme.Background
    toggleButton.AutoButtonColor = false
    makeCornered(toggleButton, 11)
    toggleButton.Parent = holder

    local knob = Instance.new("Frame")
    knob.Name = "Knob"
    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.Position = UDim2.new(0, 2, 0, 2)
    knob.BackgroundColor3 = self.Window.Theme.Subtext
    makeCornered(knob, 9)
    knob.Parent = toggleButton

    local state = settings.Default and true or false
    local function reflectState(animated)
        local goalPos = state and UDim2.new(1, -20, 0, 2) or UDim2.new(0, 2, 0, 2)
        local goalColor = state and self.Window.Theme.Accent or self.Window.Theme.Subtext
        if animated then
            tween(knob, TweenInfo.new(0.12), {Position = goalPos, BackgroundColor3 = Color3.new(1, 1, 1)})
            tween(toggleButton, TweenInfo.new(0.12), {BackgroundColor3 = state and self.Window.Theme.Accent:Lerp(self.Window.Theme.Background, 0.35) or self.Window.Theme.Background})
            tween(knob, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = goalColor})
        else
            knob.Position = goalPos
            knob.BackgroundColor3 = goalColor
            toggleButton.BackgroundColor3 = state and self.Window.Theme.Accent:Lerp(self.Window.Theme.Background, 0.35) or self.Window.Theme.Background
        end
        title.TextColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Text
    end
    reflectState(false)

    toggleButton.MouseButton1Click:Connect(function()
        state = not state
        reflectState(true)
        if settings.Callback then
            settings.Callback(state)
        end
    end)

    return {
        Get = function() return state end,
        Set = function(_, newState)
            state = newState and true or false
            reflectState(true)
        end
    }
end

function Section:AddSlider(settings)
    settings = settings or {}
    assert(settings.Text, "AddSlider requires Text")
    assert(settings.Min and settings.Max, "AddSlider requires Min and Max")
    local holder, title, description = makeComponentBase(self.Window, settings.Text)
    if settings.Description then
        description.Text = settings.Description
    else
        description.Visible = false
        holder.Size = UDim2.new(1, 0, 0, 60)
    end
    holder.Parent = self.Container

    local sliderFrame = Instance.new("Frame")
    sliderFrame.Name = "Slider"
    sliderFrame.Size = UDim2.new(1, -20, 0, 30)
    sliderFrame.Position = UDim2.new(0, 0, 0, 32)
    sliderFrame.BackgroundTransparency = 1
    sliderFrame.Parent = holder

    local bar = Instance.new("Frame")
    bar.Name = "Bar"
    bar.Position = UDim2.new(0, 10, 0, 12)
    bar.Size = UDim2.new(1, -80, 0, 6)
    bar.BackgroundColor3 = self.Window.Theme.SectionBorder
    makeCornered(bar, 3)
    bar.Parent = sliderFrame

    local fill = Instance.new("Frame")
    fill.Name = "Fill"
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = self.Window.Theme.Accent
    makeCornered(fill, 3)
    fill.Parent = bar

    local knob = Instance.new("TextButton")
    knob.Name = "Knob"
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(0, 0, 0.5, 0)
    knob.Text = ""
    knob.AutoButtonColor = false
    knob.BackgroundColor3 = self.Window.Theme.Accent
    makeCornered(knob, 8)
    createStroke(knob, Color3.fromRGB(0, 0, 0), 1).Transparency = 0.7
    knob.Parent = bar

    local valueLabel = Instance.new("TextLabel")
    valueLabel.Name = "Value"
    valueLabel.Size = UDim2.new(0, 60, 1, 0)
    valueLabel.Position = UDim2.new(1, -60, 0, 0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Font = Enum.Font.Code
    valueLabel.TextSize = 14
    valueLabel.Text = "0"
    valueLabel.TextColor3 = self.Window.Theme.Accent
    valueLabel.Parent = sliderFrame

    local min = settings.Min
    local max = settings.Max
    local default = settings.Default or min
    local decimals = settings.Decimals or 0

    local function round(num)
        local mult = 10 ^ decimals
        return math.floor(num * mult + 0.5) / mult
    end

    local currentValue = math.clamp(round(default), min, max)
    local sliding = false

    local function renderValue(animated)
        local percent = (currentValue - min) / (max - min)
        local fillSize = UDim2.new(percent, 0, 1, 0)
        local knobPos = UDim2.new(percent, 0, 0.5, 0)
        valueLabel.Text = settings.Suffix and (tostring(currentValue) .. settings.Suffix) or tostring(currentValue)
        if animated then
            tween(fill, TweenInfo.new(0.1), {Size = fillSize})
            tween(knob, TweenInfo.new(0.1), {Position = knobPos})
        else
            fill.Size = fillSize
            knob.Position = knobPos
        end
    end
    renderValue(false)

    local function update(inputPosition)
        local barPos = bar.AbsolutePosition.X
        local barSize = bar.AbsoluteSize.X
        local percent = math.clamp((inputPosition.X - barPos) / barSize, 0, 1)
        local value = round(min + (max - min) * percent)
        if value ~= currentValue then
            currentValue = value
            renderValue(true)
            if settings.Callback then
                settings.Callback(currentValue)
            end
        end
    end

    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true
        end
    end)
    knob.InputEnded:Connect(function(input)
        if input.UserInputState == Enum.UserInputState.End then
            sliding = false
        end
    end)
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            update(input.Position)
            sliding = true
        end
    end)
    bar.InputEnded:Connect(function(input)
        if input.UserInputState == Enum.UserInputState.End then
            sliding = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input.Position)
        end
    end)

    return {
        Get = function() return currentValue end,
        Set = function(_, newValue)
            currentValue = math.clamp(round(newValue), min, max)
            renderValue(true)
        end
    }
end

function Section:AddDropdown(settings)
    settings = settings or {}
    assert(settings.Text, "AddDropdown requires Text")
    assert(settings.Options and #settings.Options > 0, "AddDropdown requires a non-empty Options list")

    local holder, title, description = makeComponentBase(self.Window, settings.Text)
    if settings.Description then
        description.Text = settings.Description
    else
        description.Visible = false
        holder.Size = UDim2.new(1, 0, 0, 48)
    end
    holder.Parent = self.Container

    local dropdownButton = Instance.new("TextButton")
    dropdownButton.Name = "DropdownButton"
    dropdownButton.Size = UDim2.new(1, -20, 0, 30)
    dropdownButton.Position = UDim2.new(0, 0, 0, 22)
    dropdownButton.AutoButtonColor = false
    dropdownButton.Font = Enum.Font.Gotham
    dropdownButton.TextSize = 13
    dropdownButton.TextXAlignment = Enum.TextXAlignment.Left
    dropdownButton.Text = "   " .. (settings.Default or settings.Options[1])
    dropdownButton.BackgroundColor3 = self.Window.Theme.Background
    dropdownButton.TextColor3 = self.Window.Theme.Text
    makeCornered(dropdownButton, 6)
    createStroke(dropdownButton, self.Window.Theme.SectionBorder, 1).Transparency = 0.5
    dropdownButton.Parent = holder

    local arrow = Instance.new("TextLabel")
    arrow.Name = "Arrow"
    arrow.AnchorPoint = Vector2.new(1, 0.5)
    arrow.Position = UDim2.new(1, -8, 0.5, 0)
    arrow.Size = UDim2.new(0, 14, 0, 14)
    arrow.Font = Enum.Font.GothamBold
    arrow.TextSize = 14
    arrow.Text = "▼"
    arrow.TextColor3 = self.Window.Theme.Subtext
    arrow.BackgroundTransparency = 1
    arrow.Parent = dropdownButton

    local optionHolder = Instance.new("Frame")
    optionHolder.Name = "Options"
    optionHolder.Size = UDim2.new(1, 0, 0, 0)
    optionHolder.Position = UDim2.new(0, 0, 1, 4)
    optionHolder.BackgroundColor3 = self.Window.Theme.Background
    optionHolder.Visible = false
    optionHolder.ClipsDescendants = true
    makeCornered(optionHolder, 6)
    createStroke(optionHolder, self.Window.Theme.SectionBorder, 1).Transparency = 0.6
    optionHolder.Parent = dropdownButton

    local optionList = Instance.new("UIListLayout")
    optionList.Padding = UDim.new(0, 2)
    optionList.SortOrder = Enum.SortOrder.LayoutOrder
    optionList.Parent = optionHolder

    local open = false
    local options = {}
    for _, option in ipairs(settings.Options) do
        local button = Instance.new("TextButton")
        button.Name = "Option_" .. option
        button.Size = UDim2.new(1, 0, 0, 24)
        button.Text = option
        button.Font = Enum.Font.Gotham
        button.TextSize = 13
        button.TextColor3 = self.Window.Theme.Text
        button.BackgroundColor3 = self.Window.Theme.Background
        button.AutoButtonColor = false
        button.Parent = optionHolder

        button.MouseEnter:Connect(function()
            tween(button, TweenInfo.new(0.12), {BackgroundColor3 = self.Window.Theme.Section})
        end)
        button.MouseLeave:Connect(function()
            tween(button, TweenInfo.new(0.12), {BackgroundColor3 = self.Window.Theme.Background})
        end)
        button.MouseButton1Click:Connect(function()
            dropdownButton.Text = "   " .. option
            if settings.Callback then
                settings.Callback(option)
            end
            open = false
            tween(optionHolder, TweenInfo.new(0.12), {Size = UDim2.new(1, 0, 0, 0)})
            tween(arrow, TweenInfo.new(0.12), {Rotation = 0})
            task.delay(0.12, function()
                optionHolder.Visible = false
            end)
        end)
        table.insert(options, option)
    end
    optionHolder.Size = UDim2.new(1, 0, 0, (#options * 26) + 6)

    dropdownButton.MouseButton1Click:Connect(function()
        open = not open
        optionHolder.Visible = true
        local height = (#options * 26) + 6
        tween(optionHolder, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = open and UDim2.new(1, 0, 0, height) or UDim2.new(1, 0, 0, 0)
        })
        tween(arrow, TweenInfo.new(0.12), {Rotation = open and 180 or 0})
        if not open then
            task.delay(0.13, function()
                if not open then
                    optionHolder.Visible = false
                end
            end)
        end
    end)

    return {
        Set = function(_, newOption)
            dropdownButton.Text = "   " .. newOption
        end,
        Close = function()
            if open then
                dropdownButton:Click()
            end
        end
    }
end

