-- SuperCoolUILibrary.lua
-- A polished Roblox UI library with tabs, toggles, buttons, sliders, and dropdowns.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local UILibrary = {}
UILibrary.__index = UILibrary

local THEME_DEFAULTS = {
    Primary = Color3.fromRGB(20, 20, 20),
    Accent = Color3.fromRGB(94, 255, 122),
    AccentDark = Color3.fromRGB(36, 167, 89),
    AccentText = Color3.fromRGB(255, 255, 255),
    Background = Color3.fromRGB(10, 10, 10),
    Section = Color3.fromRGB(24, 24, 24),
    SectionBorder = Color3.fromRGB(41, 41, 41),
    Text = Color3.fromRGB(220, 220, 220),
    Subtext = Color3.fromRGB(170, 170, 170),
    Interactive = Color3.fromRGB(45, 45, 45),
    Stroke = Color3.fromRGB(80, 80, 80)
}

local function deepCopy(tbl)
    local new = {}
    for k, v in pairs(tbl) do
        new[k] = typeof(v) == "table" and deepCopy(v) or v
    end
    return new
end

local function applyTheme(instance, props)
    for prop, value in pairs(props) do
        instance[prop] = value
    end
end

local function createStroke(parent, color, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = thickness or 1
    stroke.Color = color
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = parent
    return stroke
end

local function makeCornered(instance, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius)
    corner.Parent = instance
    return corner
end

local function tween(instance, info, props)
    TweenService:Create(instance, info, props):Play()
end

local function getPlayerGui()
    local localPlayer = Players.LocalPlayer
    if not localPlayer then
        error("SuperCoolUILibrary must be used from a LocalScript.")
    end
    return localPlayer:WaitForChild("PlayerGui")
end

--[[ Window Object ]]--
local Window = {}
Window.__index = Window

function UILibrary:CreateWindow(options)
    options = options or {}
    local theme = options.Theme and deepCopy(options.Theme) or deepCopy(THEME_DEFAULTS)
    local title = options.Title or "Super Cool UI"
    local subtitle = options.Subtitle or "Utility Suite"
    local size = options.Size or Vector2.new(530, 420)

    local self = setmetatable({
        Theme = theme,
        Tabs = {},
        ActiveTab = nil
    }, Window)

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = options.GuiName or "SuperCoolUILib"
    screenGui.IgnoreGuiInset = true
    screenGui.ResetOnSpawn = false
    screenGui.DisplayOrder = options.DisplayOrder or 10
    screenGui.Parent = getPlayerGui()
    self.ScreenGui = screenGui

    local mainFrame = Instance.new("Frame")
    mainFrame.Name = "Window"
    mainFrame.Size = UDim2.fromOffset(size.X, size.Y)
    mainFrame.Position = UDim2.new(0.5, -size.X / 2, 0.5, -size.Y / 2)
    applyTheme(mainFrame, {
        BackgroundColor3 = theme.Primary
    })
    mainFrame.Parent = screenGui
    makeCornered(mainFrame, 8)
    createStroke(mainFrame, theme.Stroke, 1)

    local shadow = Instance.new("ImageLabel")
    shadow.Name = "OuterShadow"
    shadow.BackgroundTransparency = 1
    shadow.Image = "rbxassetid://6014261993"
    shadow.ScaleType = Enum.ScaleType.Slice
    shadow.SliceCenter = Rect.new(49, 49, 450, 450)
    shadow.Size = UDim2.new(1, 30, 1, 30)
    shadow.Position = UDim2.new(0, -15, 0, -15)
    shadow.ImageTransparency = 0.35
    shadow.ZIndex = 0
    shadow.Parent = mainFrame

    local topBar = Instance.new("Frame")
    topBar.Name = "TopBar"
    topBar.Size = UDim2.new(1, 0, 0, 38)
    applyTheme(topBar, {
        BackgroundColor3 = theme.Section
    })
    topBar.Parent = mainFrame
    makeCornered(topBar, 8)

    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, theme.Section),
        ColorSequenceKeypoint.new(1, theme.Primary)
    }
    gradient.Rotation = 90
    gradient.Parent = topBar

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Name = "Title"
    titleLabel.AnchorPoint = Vector2.new(0, 0.5)
    titleLabel.Position = UDim2.new(0, 16, 0.5, -2)
    titleLabel.Size = UDim2.new(0.6, -16, 0, 22)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.Text = title
    applyTheme(titleLabel, {
        TextColor3 = theme.Accent,
        TextSize = 18,
        TextXAlignment = Enum.TextXAlignment.Left
    })
    titleLabel.Parent = topBar

    local subtitleLabel = Instance.new("TextLabel")
    subtitleLabel.Name = "Subtitle"
    subtitleLabel.AnchorPoint = Vector2.new(0, 0.5)
    subtitleLabel.Position = UDim2.new(0, 16, 0.5, 14)
    subtitleLabel.Size = UDim2.new(0.6, -16, 0, 16)
    subtitleLabel.BackgroundTransparency = 1
    subtitleLabel.Font = Enum.Font.Gotham
    subtitleLabel.Text = subtitle
    applyTheme(subtitleLabel, {
        TextColor3 = theme.Subtext,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left
    })
    subtitleLabel.Parent = topBar

    local controlHolder = Instance.new("Frame")
    controlHolder.Name = "Controls"
    controlHolder.AnchorPoint = Vector2.new(1, 0.5)
    controlHolder.Position = UDim2.new(1, -12, 0.5, 0)
    controlHolder.Size = UDim2.new(0, 80, 1, 0)
    controlHolder.BackgroundTransparency = 1
    controlHolder.Parent = topBar

    local function createTopButton(order, color, tooltip, callback)
        local button = Instance.new("TextButton")
        button.Size = UDim2.fromOffset(18, 18)
        button.Position = UDim2.new(1, -(20 * order), 0.5, 0)
        button.AnchorPoint = Vector2.new(1, 0.5)
        button.Text = ""
        button.AutoButtonColor = false
        applyTheme(button, {
            BackgroundColor3 = color
        })
        makeCornered(button, 6)
        createStroke(button, Color3.fromRGB(0, 0, 0), 1).Transparency = 0.75
        button.Parent = controlHolder

        button.MouseEnter:Connect(function()
            tween(button, TweenInfo.new(0.15), {BackgroundColor3 = color:Lerp(Color3.new(1, 1, 1), 0.2)})
        end)
        button.MouseLeave:Connect(function()
            tween(button, TweenInfo.new(0.15), {BackgroundColor3 = color})
        end)
        button.MouseButton1Click:Connect(callback)

        if tooltip then
            button.MouseEnter:Connect(function()
                titleLabel.Text = tooltip
            end)
            button.MouseLeave:Connect(function()
                titleLabel.Text = title
            end)
        end
        return button
    end

    local isCollapsed = false
    createTopButton(1, Color3.fromRGB(83, 177, 82), "Toggle minimize", function()
        isCollapsed = not isCollapsed
        tween(mainFrame, TweenInfo.new(0.2), {Size = isCollapsed and UDim2.fromOffset(size.X, 38) or UDim2.fromOffset(size.X, size.Y)})
    end)

    createTopButton(2, Color3.fromRGB(242, 211, 67), "Recenter window", function()
        tween(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Position = UDim2.new(0.5, -size.X / 2, 0.5, isCollapsed and -19 or -size.Y / 2)
        })
    end)

    createTopButton(3, Color3.fromRGB(241, 98, 94), "Close window", function()
        tween(mainFrame, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundTransparency = 1})
        tween(shadow, TweenInfo.new(0.18), {ImageTransparency = 1})
        tween(topBar, TweenInfo.new(0.18), {BackgroundTransparency = 1})
        for _, child in ipairs(mainFrame:GetDescendants()) do
            if child:IsA("GuiObject") and child ~= topBar then
                tween(child, TweenInfo.new(0.18), {BackgroundTransparency = 1, TextTransparency = 1})
            end
        end
        task.delay(0.2, function()
            screenGui:Destroy()
        end)
    end)

    -- Drag handling
    local dragging = false
    local dragStart, startPos
    topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
        end
    end)
    topBar.InputEnded:Connect(function(input)
        if input.UserInputState == Enum.UserInputState.End then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    local navWrapper = Instance.new("Frame")
    navWrapper.Name = "NavWrapper"
    navWrapper.Position = UDim2.fromOffset(14, 50)
    navWrapper.Size = UDim2.new(0, 150, 1, -64)
    navWrapper.BackgroundTransparency = 1
    navWrapper.Parent = mainFrame

    local navList = Instance.new("Frame")
    navList.Name = "TabButtons"
    navList.BackgroundTransparency = 1
    navList.Size = UDim2.new(1, 0, 1, 0)
    navList.Parent = navWrapper

    local navLayout = Instance.new("UIListLayout")
    navLayout.SortOrder = Enum.SortOrder.LayoutOrder
    navLayout.Padding = UDim.new(0, 6)
    navLayout.Parent = navList

    local contentArea = Instance.new("Frame")
    contentArea.Name = "Content"
    contentArea.Position = UDim2.new(0, 180, 0, 50)
    contentArea.Size = UDim2.new(1, -194, 1, -64)
    applyTheme(contentArea, {BackgroundColor3 = theme.Background})
    contentArea.Parent = mainFrame
    makeCornered(contentArea, 8)
    createStroke(contentArea, theme.SectionBorder, 1).Transparency = 0.2

    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, 12)
    padding.PaddingLeft = UDim.new(0, 12)
    padding.PaddingRight = UDim.new(0, 12)
    padding.PaddingBottom = UDim.new(0, 12)
    padding.Parent = contentArea

    self.MainFrame = mainFrame
    self.NavHolder = navList
    self.ContentHolder = contentArea

    return self
end

function Window:SetTheme(themeOverrides)
    for key, value in pairs(themeOverrides) do
        if self.Theme[key] then
            self.Theme[key] = value
        end
    end
end

--[[ Tab Object ]]--
local Tab = {}
Tab.__index = Tab

function Window:AddTab(tabOptions)
    tabOptions = type(tabOptions) == "string" and {Name = tabOptions} or tabOptions
    tabOptions = tabOptions or {}
    local name = tabOptions.Name or "Tab"
    local icon = tabOptions.Icon or "◉"

    local tabButton = Instance.new("TextButton")
    tabButton.Name = "TabButton_" .. name
    tabButton.Size = UDim2.new(1, 0, 0, 36)
    applyTheme(tabButton, {
        BackgroundColor3 = self.Theme.Background,
        TextColor3 = self.Theme.Subtext
    })
    tabButton.Font = Enum.Font.GothamBold
    tabButton.Text = icon .. "  " .. name
    tabButton.TextSize = 14
    tabButton.AutoButtonColor = false
    tabButton.Parent = self.NavHolder
    makeCornered(tabButton, 6)
    createStroke(tabButton, self.Theme.SectionBorder, 1).Transparency = 0.4

    local tabContent = Instance.new("ScrollingFrame")
    tabContent.Name = "TabContent_" .. name
    tabContent.Size = UDim2.new(1, 0, 1, 0)
    tabContent.CanvasSize = UDim2.new(0, 0, 0, 0)
    tabContent.ScrollBarThickness = 3
    tabContent.BackgroundTransparency = 1
    tabContent.Visible = false
    tabContent.Parent = self.ContentHolder

    local tabLayout = Instance.new("UIListLayout")
    tabLayout.Padding = UDim.new(0, 10)
    tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tabLayout.Parent = tabContent

    local tabPadding = Instance.new("UIPadding")
    tabPadding.PaddingRight = UDim.new(0, 6)
    tabPadding.Parent = tabContent

    local tabObject = setmetatable({
        Window = self,
        Name = name,
        Button = tabButton,
        Content = tabContent,
        Sections = {}
    }, Tab)

    tabButton.MouseButton1Click:Connect(function()
        self:SelectTab(tabObject)
    end)

    self.Tabs[name] = tabObject
    if not self.ActiveTab then
        self:SelectTab(tabObject)
    end

    return tabObject
end

function Window:SelectTab(tabObject)
    if self.ActiveTab == tabObject then
        return
    end

    for _, tab in pairs(self.Tabs) do
        tab.Button.TextColor3 = self.Theme.Subtext
        tab.Button.BackgroundColor3 = self.Theme.Background
        tab.Content.Visible = false
    end

    tabObject.Button.TextColor3 = self.Theme.Accent
    tabObject.Button.BackgroundColor3 = self.Theme.Section
    tabObject.Content.Visible = true
    self.ActiveTab = tabObject
end

