function Tab:AddButton(settings)
    local defaultSection = self.Sections[1] or self:AddSection("Actions")
    return defaultSection:AddButton(settings)
end

function Tab:AddToggle(settings)
    local defaultSection = self.Sections[1] or self:AddSection("Toggles")
    return defaultSection:AddToggle(settings)
end

function Tab:AddSlider(settings)
    local defaultSection = self.Sections[1] or self:AddSection("Sliders")
    return defaultSection:AddSlider(settings)
end

function Tab:AddDropdown(settings)
    local defaultSection = self.Sections[1] or self:AddSection("Dropdowns")
    return defaultSection:AddDropdown(settings)
end

